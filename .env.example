DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_OUTPUT_FILE=discord_channel_messages.jsonl
DISCORD_REQUEST_DELAY_SECONDS=0.25
DISCORD_PROXY_URL=http://127.0.0.1:10808
DISCORD_POLL_INTERVAL_SECONDS=2.0
DISCORD_MONITOR_STATE_FILE=data/discord_channel_watch_state.json
DISCORD_DEFAULT_ENTRY_CONTRACT_TYPE=
DISCORD_DEFAULT_ENTRY_EXPIRY_LABEL=
DISCORD_AUDIT_CHANNEL_ID=

# Options Relay / NATS Feed
NATS_SERVER_ADDRESS=127.0.0.1:4222
NATS_SUBJECT=signals.options.entry
NATS_QUEUE_GROUP=
NATS_AUTO_SUBSCRIBE=true

# Optional headless relay overrides / secrets
OPTIONS_RELAY_HOME=
MOOMOO_TRADE_PASSWORD=
MOOMOO_TRADE_PASSWORD_MD5=